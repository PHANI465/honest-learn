{
  "expo": {
    "name": "Honest Learn",
    "slug": "honest-learn",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.honestlearn.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E3F0E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.honestlearn.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Honest Learn",
      "shortName": "Honest Learn",
      "description": "Free, safe, age-appropriate learning for ages 3–18. No ads.",
      "lang": "en",
      "themeColor": "#2F6B4F",
      "backgroundColor": "#FBF8F3",
      "display": "standalone",
      "startUrl": "/",
      "orientation": "portrait",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "honestlearn",
    "description": "Free, safe, age-appropriate learning for ages 3–18. No ads."
  }
}
