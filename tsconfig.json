{
  // Used by Vercel when it compiles the API function (api/index.ts and the server/src files it imports).
  // The server imports its own files as "./x.ts" (run directly by tsx); rewriteRelativeImportExtensions
  // turns those into "./x.js" in the compiled function. server/ and app/ have their own tsconfig.json.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["api"]
}
