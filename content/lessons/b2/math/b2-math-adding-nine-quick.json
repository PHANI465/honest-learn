  "sections": [
    {
      "type": "text",
      "body": "Adding 10 is easy. 34 + 10 = 44. The tens digit goes up by one and the ones stay the same."
    },
    {
      "type": "text",
      "body": "9 is just 1 less than 10. So to add 9, add 10 and then take away 1. For 34 + 9: 34 + 10 = 44, and 44 - 1 = 43."
    },
    {
      "type": "text",
      "body": "11 is just 1 more than 10. To add 11, add 10 and then add 1. For 34 + 11: 34 + 10 = 44, and 44 + 1 = 45."
    },
    {
      "type": "tryit",
      "body": "Pick a number under 50. Add 9 the quick way, then count on 9 steps to check. Do you get the same answer?"
    },
    {
      "type": "parent",
      "body": "This is a mental-maths habit: change a hard sum into an easy one and fix it after. Let your child choose the numbers and check each answer with objects or a hundred square."
    }
  ],
  "quiz": [
    {
      "q": "What is 36 + 9?",
      "options": [
        "45",
        "46",
        "44"
      ],
      "answer": 0,
      "hints": [
        "9 is one less than 10.",
        "Add 10 first, then take away 1.",
        "Example: 25 + 9 → 25 + 10 = 35, then 35 - 1 = 34. Now do 36 + 9."
      ],
      "explain": "36 + 10 = 46, and 46 - 1 = 45."
    },
    {
      "q": "What is 52 + 11?",
      "options": [
        "63",
        "62",
        "64"
      ],
      "answer": 0,
      "hints": [
        "11 is one more than 10.",
        "Add 10 first, then add 1.",
        "Example: 43 + 11 → 43 + 10 = 53, then 53 + 1 = 54. Now do 52 + 11."
      ],
      "explain": "52 + 10 = 62, and 62 + 1 = 63."
    },
    {
      "q": "Sam has 27 marbles and wins 9 more. How many does he have?",
      "options": [
        "36",
        "35",
        "37"
      ],
      "answer": 0,
      "hints": [
        "'Wins 9 more' means add 9.",
        "Add 10, then take away 1.",
        "Example: 18 + 9 → 18 + 10 = 28, then 28 - 1 = 27. Do the same with 27 + 9."
      ],
      "explain": "27 + 10 = 37, and 37 - 1 = 36 marbles."
    }
