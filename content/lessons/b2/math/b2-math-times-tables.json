  "sections": [
    {
      "type": "text",
      "body": "Multiplication means equal groups. 3 groups of 2 apples = 2 + 2 + 2 = 6. We write 3 × 2 = 6."
    },
    {
      "type": "text",
      "body": "The 2 times table counts in 2s: 2, 4, 6, 8, 10…"
    },
    {
      "type": "text",
      "body": "The 5 times table counts in 5s: 5, 10, 15, 20… The 10 times table counts in 10s: 10, 20, 30…"
    },
    {
      "type": "fact",
      "body": "3 × 2 is the same as 2 × 3. You can swap the numbers!"
    },
    {
      "type": "parent",
      "body": "Count in 2s, 5s and 10s on walks or stairs. Real objects (coins, socks in pairs) make it concrete."
    }
  ],
  "quiz": [
    {
      "q": "4 bags each have 5 sweets. How many sweets?",
