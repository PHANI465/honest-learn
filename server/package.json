{
  "name": "honest-learn-server",
  "version": "0.5.0",
  "description": "Honest Learn API: parent accounts, child profiles, PIN-gated parental controls, progress and AI hint tutor",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "test:pg": "node scripts/run-pg-tests.mjs",
    "test:portable": "node scripts/run-portable-tests.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/validate-content.ts",
    "redteam": "tsx src/hoot-redteam.ts",
    "compose:chess": "tsx src/games/compose-chess.ts",
    "compose:chess-lessons": "tsx src/games/gen-chess-lessons.ts",
    "preview": "tsx src/preview.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@hono/node-server": "^2.1.6",
    "@neondatabase/serverless": "^1.2.0",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "chess.js": "1.4.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module"
}
