{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix server",
  "buildCommand": "cd app && npm ci && EXPO_PUBLIC_API_URL=/api npx expo export --platform web",
  "outputDirectory": "app/dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "content/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/|api$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
